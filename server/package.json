{
  "name": "booknow-server",
  "version": "2.0.0",
  "private": true,
  "description": "BookNow API: seat holds with Redis locks, PostgreSQL-backed bookings, waitlist and payments.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
